      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(find:*)", "Bash(grep:*)", "Bash(rg:*)", "Bash(pwd)", "Bash(which:*)", "Bash(mkdir:*)", "Bash(touch:*)", "Bash(echo:*)", "Bash(date:*)", "Bash(tree:*)"
