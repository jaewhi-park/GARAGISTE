{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/CHARTER*.md", "docs/STATUS*.md"],
  "subagent_depth": 2,
  "permission": {
    "external_directory": "deny",
    "edit": "ask",
    "bash": "ask"
  },
  "agent": {
    "explore": {
      "permission": {
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls *": "allow",
          "dir *": "allow",
          "tree *": "allow",
          "find *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "du *": "allow",
          "grep *": "allow",
          "findstr *": "allow",
          "rg *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "tr *": "allow",
          "awk *": "allow",
          "which *": "allow",
          "where *": "allow",
          "echo *": "allow",
          "Get-ChildItem *": "allow",
          "gci *": "allow",
          "Get-Content *": "allow",
          "gc *": "allow",
          "type *": "allow",
          "Select-String *": "allow",
          "sls *": "allow",
          "Get-Command *": "allow",
          "Test-Path *": "allow",
          "Get-Location": "allow",
          "Select-Object *": "allow",
          "Measure-Object *": "allow",
          "Sort-Object *": "allow",
          "git status *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "git rev-parse *": "allow",
          "git branch *": "allow",
          "git remote *": "allow",
          "git tag *": "allow",
          "git describe *": "allow",
          "git ls-files *": "allow",
          "git blame *": "allow",
          "git worktree list *": "allow",
          "git config --get *": "allow",
          "node --version": "allow",
          "node -v": "allow",
          "npm --version": "allow",
          "npm ls *": "allow",
          "npm view *": "allow",
          "pnpm --version": "allow",
          "pnpm ls *": "allow",
          "yarn --version": "allow",
          "bun --version": "allow",
          "python --version": "allow",
          "python -V": "allow",
          "python3 --version": "allow",
          "python3 -V": "allow",
          "pip list *": "allow",
          "pip show *": "allow",
          "uv --version": "allow",
          "uv pip list *": "allow",
          "poetry show *": "allow",
          "go version": "allow",
          "go list *": "allow",
          "go env *": "allow",
          "cargo --version": "allow",
          "cargo tree *": "allow",
          "cargo metadata *": "allow",
          "rustc --version": "allow",
          "dotnet --version": "allow",
          "dotnet --list-sdks": "allow",
          "dotnet list *": "allow",
          "java -version": "allow",
          "mvn --version": "allow",
          "mvn dependency:tree *": "allow",
          "gradle --version": "allow",
          "gradle dependencies *": "allow",
          "make -n *": "allow",
          "docker --version": "allow",
          "docker compose config *": "allow"
        }
      }
    }
  }
}
