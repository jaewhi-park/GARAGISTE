* text=auto eol=lf
# Shell scripts and Node hooks must stay LF so they run on macOS/Linux/WSL even when cloned on Windows
*.sh   text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
# PowerShell scripts carry a UTF-8 BOM (required by Windows PowerShell 5.1 for non-ASCII); LF is fine for PowerShell
*.ps1  text eol=lf
