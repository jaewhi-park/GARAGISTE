{
  "agent": "team-lead",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge --no-ff:*)",
      "Bash(git merge --ff-only origin/main:*)",
      "Bash(git merge --ff-only origin/master:*)",
      "Bash(git rebase origin/main:*)",
      "Bash(git rebase origin/master:*)",
      "Bash(git rebase --abort:*)",
      "Bash(git remote:*)",
      "Bash(git worktree list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh pr view:*)",
      "Bash(node .claude/scripts/apply-models.mjs:*)",
      "Bash(node .claude/scripts/set-language.mjs:*)",
      "Bash(node .claude/scripts/new-agent.mjs:*)",
      "Bash(node .claude/scripts/set-profile.mjs:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guardrails.mjs"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
