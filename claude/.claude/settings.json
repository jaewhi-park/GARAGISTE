{
  "agent": "team-lead",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge --no-ff:*)",
      "Bash(git merge --ff-only origin/main:*)",
      "Bash(git merge --ff-only origin/master:*)",
      "Bash(git rebase origin/main:*)",
      "Bash(git rebase origin/master:*)",
      "Bash(git rebase --abort:*)",
      "Bash(git remote:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree remove:*)",
      "Bash(git revert:*)",
      "Bash(git tag -a:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge --auto:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh pr view:*)",
      "Bash(node .claude/scripts/apply-models.mjs:*)",
      "Bash(node .claude/scripts/set-language.mjs:*)",
      "Bash(node .claude/scripts/new-agent.mjs:*)",
      "Bash(node .claude/scripts/set-profile.mjs:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rm --cached:*)",
      "Bash(git push -u origin:*)",
      "Bash(git worktree add:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git stash list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(bun:*)",
      "Bash(npx:*)",
      "Bash(deno:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(poetry:*)",
      "Bash(pip:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(go:*)",
      "Bash(cargo:*)",
      "Bash(dotnet:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew:*)",
      "Bash(make:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(vitest:*)",
      "Bash(jest:*)",
      "Bash(playwright:*)",
      "Bash(node --version)",
      "Bash(node -v)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guardrails.mjs"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
